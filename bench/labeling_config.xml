<View>
  <Header value="Draw a box around EVERY sensitive region in the frame. Tight boxes; include the whole face/head, the full screen glass, the whole paper. Leave the frame empty if nothing is sensitive, then Submit."/>
  <Image name="image" value="$image" zoom="true" zoomControl="true" rotateControl="false"/>
  <RectangleLabels name="box" toName="image" strokeWidth="2" canRotate="false">
    <Label value="face" background="#ff8c00" hotkey="1"/>
    <Label value="screen" background="#00aaff" hotkey="2"/>
    <Label value="phone_screen" background="#00c88c" hotkey="3"/>
    <Label value="document" background="#aa5aff" hotkey="4"/>
    <Label value="plate" background="#ffdc00" hotkey="5"/>
    <Label value="id_card" background="#ff50a0" hotkey="6"/>
  </RectangleLabels>
</View>
